{
  "name": "ProblemBank",
  "type": "object",
  "properties": {
    "topic": {
      "type": "string",
      "description": "Main topic name"
    },
    "subtopic": {
      "type": "string",
      "description": "Subtopic name"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ],
      "default": "beginner"
    },
    "question_text": {
      "type": "string",
      "description": "The practice question text"
    },
    "correct_answer": {
      "type": "string"
    },
    "solution_steps": {
      "type": "string",
      "description": "Step-by-step solution"
    },
    "hints": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "default": "English"
    },
    "subject_id": {
      "type": "string",
      "description": "Optional: scope to a specific subject"
    },
    "source": {
      "type": "string",
      "enum": [
        "ai",
        "textbook"
      ],
      "default": "ai"
    },
    "times_used": {
      "type": "number",
      "default": 0,
      "description": "How many times this question has been served"
    }
  },
  "required": [
    "topic",
    "question_text"
  ]
}
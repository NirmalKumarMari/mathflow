{
  "name": "PracticeQuestion",
  "type": "object",
  "properties": {
    "topic": {
      "type": "string"
    },
    "subtopic": {
      "type": "string"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "question_text": {
      "type": "string"
    },
    "correct_answer": {
      "type": "string"
    },
    "student_answer": {
      "type": "string"
    },
    "is_correct": {
      "type": "boolean"
    },
    "explanation": {
      "type": "string"
    },
    "hints": {
      "type": "string"
    },
    "session_id": {
      "type": "string",
      "description": "Groups questions into sessions"
    }
  },
  "required": [
    "topic",
    "question_text"
  ]
}
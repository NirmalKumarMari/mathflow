{
  "name": "Subject",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name e.g. '7th Grade Math', 'Physics'"
    },
    "subject_type": {
      "type": "string",
      "enum": [
        "math",
        "custom"
      ],
      "default": "custom",
      "description": "math = uses built-in syllabus by grade; custom = AI-generated or uploaded syllabus topics"
    },
    "grade_level": {
      "type": "string",
      "enum": [
        "6th",
        "7th",
        "8th",
        "9th",
        "10th",
        "11th",
        "12th",
        "adaptive"
      ],
      "description": "Grade level for the subject"
    },
    "description": {
      "type": "string",
      "description": "Short description of the subject"
    },
    "color": {
      "type": "string",
      "description": "Accent color key"
    },
    "country": {
      "type": "string",
      "description": "Selected country/region for syllabus"
    },
    "language": {
      "type": "string",
      "description": "Tutoring language for this subject (from textbook or country)",
      "default": "English"
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "subtopics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": "string"
          },
          "difficulty": {
            "type": "string"
          },
          "youtube_videos": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "description": "Topics for the subject (from uploaded syllabus JSON or AI-generated)"
    },
    "textbook_url": {
      "type": "string",
      "description": "URL to uploaded textbook PDF"
    },
    "textbook_title": {
      "type": "string",
      "description": "Name of the uploaded textbook"
    },
    "syllabus_url": {
      "type": "string",
      "description": "URL to uploaded syllabus JSON file"
    },
    "youtube_videos_url": {
      "type": "string",
      "description": "URL to uploaded YouTube videos JSON file"
    },
    "placement_completed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the student has completed the placement test for this subject"
    }
  },
  "required": [
    "name",
    "subject_type"
  ]
}